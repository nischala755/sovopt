# Keep this file free of real credentials.
MISTRAL_API_KEY=
SOVEREIGN_AI_PROVIDER=mistral
# For a local demo, set SOVEREIGN_AI_PROVIDER=qwen and run Ollama with qwen3.5:2b.
SOVEREIGN_QWEN_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://127.0.0.1:11434
SOVEREIGN_DATA_DIR=.sovereign-data
SOVEREIGN_MAX_UPLOAD_BYTES=10485760
SOVEREIGN_MAX_ACTIVE_JOBS=4
SOVEREIGN_MAX_TELEMETRY_EVENTS=1000

